# === Database ===
POSTGRES_DB=iReports
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password

# === Backend ===
PORT=3000
SECRET_ACCESS=change_me_access_secret
SECRET_REFRESH=change_me_refresh_secret
BCRYPT_ROUNDS=10

# === Bitrix24 ===
BITRIX24_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/USER_ID/WEBHOOK_KEY/
# OAuth-приложение (из партнёрского кабинета или настроек локального приложения на портале)
BITRIX24_CLIENT_ID=app.xxxxxxxxxx.xxxxxxxxxx
BITRIX24_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Roapp ===
ROAPP_TOKEN=your_roapp_token_here

# === MoySklad ===
MOYSKLAD_TOKEN=your_moysklad_token_here

# === AI (Omnirote) ===
OMNIROTE_TOKEN=your_omnirote_token_here

# === CORS ===
# Production: your domain, e.g. https://reports.example.com
# With Nginx proxy on same host: http://localhost
CORS_ORIGIN=http://localhost

# === Observability (logging/metrics) ===
LOG_LEVEL=info
LOKI_HOST=http://loki:3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin_password