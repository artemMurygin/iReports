# Единый .env для всего репозитория — используется и docker-compose (корень), и backend
# при локальном запуске (backend/.env — симлинок на этот файл, см. корневой CLAUDE.md/README).

# === Database ===
POSTGRES_DB=iReports
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password

# === Backend ===
PORT=3000
SECRET_ACCESS=change_me_access_secret
SECRET_REFRESH=change_me_refresh_secret
BCRYPT_ROUNDS=10
# Включает cron-синхронизации с внешними ERP (см. backend/src/shared/cron); для локальной
# разработки без доступа к продовым интеграциям обычно оставляют false
ENABLE_CRON=false
LOG_LEVEL=debug

# === Bitrix24 ===
BITRIX24_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/USER_ID/WEBHOOK_KEY/
# OAuth-приложение (из партнёрского кабинета или настроек локального приложения на портале)
BITRIX24_CLIENT_ID=app.xxxxxxxxxx.xxxxxxxxxx
BITRIX24_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Roapp ===
ROAPP_TOKEN=your_roapp_token_here
# Касса (Finance Account) RemOnline для выплат зарплаты (PRD 3, Фаза 11/12) —
# см. backend/src/domains/service/modules/accounting/config/erp-cash.config.ts
ROAPP_CASHBOX_ID=
# Статья движения денег (Cashflow Category ID) — обязательна для POST
# .../transactions, без неё RemOnline отклоняет запрос 400 (обнаружено 2026-08-25)
ROAPP_CATEGORY_ID=

# === MoySklad ===
MOYSKLAD_TOKEN=your_moysklad_token_here
# Статья расходов, статья доходов (не используется адаптером, задел) и
# юрлицо МойСклад для выплат зарплаты (PRD 3, Фаза 11/12) — см.
# backend/src/domains/shop/modules/accounting/config/erp-cash.config.ts
MOYSKLAD_EXPENSE_ITEM_ID=
MOYSKLAD_INCOME_ITEM_ID=
MOYSKLAD_ORGANIZATION_ID=

# === Google Sheets ===
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxxxxxxxxxxxxxxxxxxxx\n-----END PRIVATE KEY-----\n"

# === AI (Omnirote) ===
OMNIROTE_TOKEN=your_omnirote_token_here
OMNIROTE_URL=https://your-omnirote-endpoint.example.com
OMNIROUTE_BASE_MODEL=gpt-4o-mini

# === CORS ===
# Production: your domain, e.g. https://reports.example.com
# With Nginx proxy on same host: http://localhost
CORS_ORIGIN=http://localhost

# === Мониторинг (Loki/Grafana) ===
LOKI_HOST=http://localhost:3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
