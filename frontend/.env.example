# VITE_API_URL — по умолчанию http://localhost:3000 (см. shared/api/axios.instance.ts), задавать
# нужно только если backend слушает другой адрес/порт.
# VITE_API_URL=http://localhost:3000

# add-bitrix24-auth-and-rbac: client_id OAuth-приложения Bitrix24 — то же значение, что
# BITRIX24_CLIENT_ID в корневом .env.example (не секрет, в отличие от client_secret,
# который остаётся только на backend — spec: auth#client-secret-isolation). Используется
# useBitrixLogin при редиректе на {portal}/oauth/authorize/.
VITE_BITRIX24_CLIENT_ID=app.xxxxxxxxxx.xxxxxxxxxx
