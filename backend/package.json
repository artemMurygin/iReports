{
    "name": "backend",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build -c nest-cli.json && tsc-alias -p tsconfig.build.json",
        "format": "prettier --config .prettierrc --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start -c nest-cli.json",
        "start:dev": "concurrently -k -n tsc,nest \"tsc-alias -p tsconfig.build.json -w\" \"nest start -c nest-cli.json --watch\"",
        "start:debug": "nest start -c nest-cli.json --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint --config eslint.config.mjs \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "TS_NODE_PROJECT=tsconfig.json node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "initial": "nest build -c nest-cli.json && node dist/src/shared/initialUploadData.js",
        "initialProd": "node dist/src/shared/initialUploadData.js",
        "price:monitoring": "nest build -c nest-cli.json && node dist/src/utils/runPriceMonitoring.js",
        "price:monitoring:prod": "node dist/src/utils/runPriceMonitoring.js",
        "export:roapp-orders": "nest build -c nest-cli.json && node dist/src/shared/exportRoappOrders.js",
        "migrate:employee-identities": "nest build -c nest-cli.json && node dist/src/shared/migrateEmployeeIdentities.js",
        "migrate:work-schedule-hours": "nest build -c nest-cli.json && node dist/src/shared/migrateWorkScheduleHours.js",
        "migrate:task-completed-rule-configs": "nest build -c nest-cli.json && node dist/src/shared/migrateTaskCompletedRuleConfigs.js"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.1",
        "@nestjs/core": "^11.0.1",
        "@nestjs/cqrs": "^11.0.3",
        "@nestjs/event-emitter": "^3.1.0",
        "@nestjs/mapped-types": "*",
        "@nestjs/platform-express": "^11.1.29",
        "@nestjs/schedule": "^6.1.1",
        "@nestjs/swagger": "^11.4.6",
        "@prisma/adapter-pg": "^7.5.0",
        "@prisma/client": "^7.5.0",
        "@types/cron": "^2.0.1",
        "axios": "^1.13.6",
        "class-validator": "^0.14.1",
        "dotenv": "^17.3.1",
        "googleapis": "^171.4.0",
        "ireports-contracts": "*",
        "nanoid": "^3.3.16",
        "nestjs-request-context": "^4.0.0",
        "nestjs-zod": "^5.2.1",
        "openai": "^6.38.0",
        "pg": "^8.20.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "tsx": "^4.21.0",
        "xlsx": "^0.18.5",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@types/express": "^5.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.10.7",
        "@types/pg": "^8.20.0",
        "@types/supertest": "^6.0.2",
        "concurrently": "^10.0.3",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^16.0.0",
        "jest": "^30.0.0",
        "prettier": "^3.4.2",
        "prisma": "^7.5.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.1",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": [
                "ts-jest",
                {
                    "tsconfig": "<rootDir>/../tsconfig.json"
                }
            ]
        },
        "moduleNameMapper": {
            "^(\\.{1,2}/.*)\\.js$": "$1",
            "^@/(.*)$": "<rootDir>/$1"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
