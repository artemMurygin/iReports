model MotivationSchema {
  id         String   @id
  targetType String   @map("target_type")
  targetId   Int      @map("target_id")
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  rules SalaryRule[]

  @@index([targetType, targetId])
  @@map("motivation_schemas")
}

model SalaryRule {
  id                 String   @id
  motivationSchemaId String   @map("motivation_schema_id")
  type               String
  name               String
  // Роль, за которую платит правило (ENGINEER, ONLINE_MANAGER, ...) — общее
  // поле правила, а не часть его config: правило само знает, по какому полю
  // ERP искать сотрудника в этой роли (см. docs/payroll/prd-payroll-calculation.md,
  // раздел 2 "Зарплатные правила сервиса").
  targetRole         String   @map("target_role")
  // Направление, которому принадлежит правило (Фаза 12, issue #57 —
  // см. backend/src/domains/shop/modules/accounting, decision-комментарий
  // в SalaryRuleMapper направления service). ПОЧЕМУ на SalaryRule, а не на
  // MotivationSchema (в отличие от AccountingPeriod.direction, где
  // (direction, period) — независимый агрегат): одна MotivationSchema
  // адресует ОДНОГО сотрудника (targetType = 'Employee') или отдел, а
  // сотрудник вполне может числиться и в RemOnline, и в МойСклад
  // одновременно (см. EmployeeIdentity, Фаза 2) — то есть у одной схемы
  // мотивации может быть смешанный набор правил service+shop. `type`
  // правила ('PayPerHour', 'ProductSold', ...) у двух направлений
  // пересекается буквально (service и shop оба используют литерал
  // 'PayPerHour', но с разными реестрами/фабриками — issue #57 требует
  // независимости), поэтому резолвинг класса правила по одному лишь
  // (type) неоднозначен, если в выборке смешаны строки обоих направлений.
  // Решение: каждый direction-репозиторий (SalaryRuleRepository/
  // MotivationSchemaRepository своего домена) фильтрует `rules` по этому
  // полю на уровне Prisma-запроса (`where: { direction: ... }`), поэтому
  // домену того направления, что читает схему, всегда попадают только его
  // "свои" строки — SalaryRuleMapper.toDomain никогда не видит чужой type
  // и продолжает безопасно бросать NotFoundException только на реально
  // незарегистрированный (а не "чужого направления") тип. Дефолт
  // 'service' — обратная совместимость: все существующие на момент
  // миграции строки были созданы единственным на тот момент направлением.
  direction          String   @default("service")
  props              Json
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  motivationSchema MotivationSchema @relation(fields: [motivationSchemaId], references: [id], onDelete: Cascade)

  @@index([motivationSchemaId])
  @@index([motivationSchemaId, direction])
  @@map("salary_rules")
}

// Ручной ввод отработанных часов сотрудника за период — источник данных для
// PayPerHour.calculate() (Фаза 7, см. docs/payroll/plan-payroll-calculation.md).
// Полноценный график работы — вне скоупа этой итерации: одна запись — одно
// значение часов на пару (сотрудник, период), заводится/правится
// руководителем/администратором через простой CRUD.
model EmployeeHoursEntry {
  id         String @id
  employeeId Int    @map("employee_id")
  period     String
  hours      Float

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([employeeId, period])
  @@map("employee_hours_entries")
}

// Выполнение задачи сотрудником — источник данных для TaskCompleted.calculate()
// (Фаза 8, см. docs/payroll/plan-payroll-calculation.md). ВРЕМЕННЫЙ
// внутренний воркфлоу подтверждения (сотрудник отмечает выполненной →
// руководитель подтверждает статусом CONFIRMED), БЕЗ интеграции с Bitrix24
// Tasks — синхронизация с реальными задачами запланирована отдельной
// будущей фазой. description — произвольный текст-заглушка, содержимое
// сейчас не имеет значения для расчёта.
model TaskCompletion {
  id          String  @id
  employeeId  Int     @map("employee_id")
  period      String
  description String  @db.Text
  // PENDING_CONFIRMATION | CONFIRMED | REJECTED — см.
  // domain/entities/task-completion.entity.ts.
  status      String  @default("PENDING_CONFIRMATION")
  createdBy   Int     @map("created_by")
  confirmedBy Int?    @map("confirmed_by")
  confirmedAt DateTime? @map("confirmed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([period, employeeId])
  @@index([period, status])
  @@map("task_completions")
}
