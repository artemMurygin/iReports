model MotivationSchema {
  id         String   @id
  targetType String   @map("target_type")
  targetId   Int      @map("target_id")
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  rules SalaryRule[]

  @@index([targetType, targetId])
  @@map("motivation_schemas")
}

model SalaryRule {
  id                 String   @id
  motivationSchemaId String   @map("motivation_schema_id")
  type               String
  name               String
  // Роль, за которую платит правило (ENGINEER, ONLINE_MANAGER, ...) — общее
  // поле правила, а не часть его config: правило само знает, по какому полю
  // ERP искать сотрудника в этой роли (см. docs/payroll/prd-payroll-calculation.md,
  // раздел 2 "Зарплатные правила сервиса").
  targetRole         String   @map("target_role")
  props              Json
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  motivationSchema MotivationSchema @relation(fields: [motivationSchemaId], references: [id], onDelete: Cascade)

  @@index([motivationSchemaId])
  @@map("salary_rules")
}
