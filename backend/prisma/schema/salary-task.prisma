// Задача Bitrix24, связанная с зарплатным правилом типа TaskCompletion —
// openspec/changes/add-task-based-salary-rule/design.md, Decision 1/4.
// Общая для service/shop таблица с дискриминатором direction (по паттерну
// "Общие таблицы между service и shop", backend/CLAUDE.md — см. также
// SalaryAccrual/SalaryAccrualLine в salary-accrual.prisma), изоляция
// направлений — на уровне кода (раздельные Entity/Repository-классы в
// domains/service и domains/shop, каждый фильтрует/подставляет свой
// фиксированный direction). direction — String (не enum SalesDirection),
// по прецеденту SalaryRule.direction: значение прибито к правилу, а не к
// независимому агрегату (см. комментарий у SalaryRule.direction в
// salary.prisma).
//
// salaryRuleId — ссылка на SalaryRule.id БЕЗ физического @relation, по
// прецеденту SalaryAccrualLine.ruleId (salary-accrual.prisma) — правило и
// его задача живут в разных доменных агрегатах/направлениях.
//
// Уникальный индекс (salaryRuleId, period) — идемпотентность
// EnsureSalaryTaskForPeriodService.ensure() (design.md Decision 1/4):
// у правила не более одной задачи в расчётном периоде — разовое правило
// (isRecurring = false) заводит ровно одну запись за всё время жизни,
// регулярное — по одной на каждый период.
model SalaryTask {
  id           String   @id @default(uuid())
  salaryRuleId String   @map("salary_rule_id")
  direction    String
  period       String
  deadline     DateTime
  isRecurring  Boolean  @map("is_recurring")

  bitrixTaskId String    @map("bitrix_task_id")
  // Сырой код статуса задачи Bitrix24 (tasks.task.get), обновляется
  // SalaryTaskStatusSyncCron (поллинг, design.md Decision 3).
  taskStatus   String    @map("task_status")
  lastSyncedAt DateTime? @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([salaryRuleId, period])
  @@map("salary_tasks")
}
