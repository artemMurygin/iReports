model MoySkladEmployee {
  id         String  @id
  name       String
  firstName  String? @map("first_name")
  lastName   String? @map("last_name")
  middleName String? @map("middle_name")
  email      String?
  phone      String?
  position   String?
  archived   Boolean @default(false)

  onlineDemands  MoySkladDemand[] @relation("DemandOnlineManager")
  offlineDemands MoySkladDemand[] @relation("DemandOfflineManager")
  bitrixEmployee BitrixEmployee?

  @@map("moy_sklad_employees")
}

model MoySkladProductFolder {
  id       String  @id
  name     String
  pathName String  @map("path_name")
  parentId String? @map("parent_id")
  archived Boolean @default(false)

  parent   MoySkladProductFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children MoySkladProductFolder[] @relation("FolderTree")
  products MoySkladProduct[]
  services MoySkladService[]

  // Фаза 10 (issue #50): категория магазина — дерево, дочерние pathName
  // всегда начинаются с pathName родителя + "/" (формат МойСклада, см.
  // product-folder-tree.ts). Правило `ProductSold`/`UsedProductSold`
  // раскрывает фильтр по категории до всех потомков запросом
  // `pathName LIKE 'parent.pathName%'` вместо рекурсивного обхода
  // parentId — один индексированный запрос вместо O(глубина дерева)
  // последовательных походов в БД. Обычный B-tree индекс на pathName НЕ
  // ускоряет `LIKE 'prefix%'` при локали БД, отличной от "C" (сравнение по
  // умолчанию учитывает локаль и не может использовать диапазонный скан) —
  // образ pgvector/pgvector, которым поднят Postgres в docker-compose, не
  // фиксирует локаль как "C", поэтому используем operator class
  // text_pattern_ops, который сравнивает байты, а не по локали, и делает
  // индекс пригодным для префиксного LIKE.
  @@index([pathName(ops: raw("text_pattern_ops"))], type: BTree)
  @@map("moy_sklad_product_folders")
}

model MoySkladProduct {
  id          String   @id
  name        String
  code        String?
  article     String?
  description String?  @db.Text
  salePrice   Int      @map("sale_price")
  buyPrice    Int      @map("buy_price")
  folderId    String?  @map("folder_id")
  archived    Boolean  @default(false)
  updatedAt   DateTime @map("updated_at")

  folder    MoySkladProductFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  positions MoySkladDemandPosition[]

  @@map("moy_sklad_products")
}

model MoySkladService {
  id          String   @id
  name        String
  code        String?
  description String?  @db.Text
  salePrice   Int      @map("sale_price")
  folderId    String?  @map("folder_id")
  archived    Boolean  @default(false)
  updatedAt   DateTime @map("updated_at")

  folder    MoySkladProductFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  positions MoySkladDemandPosition[]

  @@map("moy_sklad_services")
}

model MoySkladDemand {
  id               String   @id
  name             String
  moment           DateTime
  createdAt        DateTime @map("created_at")
  sum              Int
  payedSum         Int      @map("payed_sum")
  agentId          String?  @map("agent_id")
  agentName        String?  @map("agent_name")
  stateId          String?  @map("state_id")
  stateName        String?  @map("state_name")
  salesChannelId   String?  @map("sales_channel_id")
  salesChannelName String?  @map("sales_channel_name")
  onlineManagerId  String?  @map("online_manager_id")
  offlineManagerId String?  @map("offline_manager_id")
  customerOrderId  String?  @map("customer_order_id")
  description      String?  @db.Text

  onlineManager  MoySkladEmployee?        @relation("DemandOnlineManager", fields: [onlineManagerId], references: [id], onDelete: SetNull)
  offlineManager MoySkladEmployee?        @relation("DemandOfflineManager", fields: [offlineManagerId], references: [id], onDelete: SetNull)
  positions      MoySkladDemandPosition[]

  @@index([moment])
  @@index([onlineManagerId])
  @@index([offlineManagerId])
  @@index([salesChannelId])
  @@map("moy_sklad_demands")
}

model MoySkladDemandPosition {
  id             String  @id
  demandId       String  @map("demand_id")
  productId      String? @map("product_id")
  serviceId      String? @map("service_id")
  assortmentName String  @map("assortment_name")
  quantity       Float
  price          Int
  discount       Float   @default(0)
  sum            Int
  cost           Int
  profit         Int

  // Закупщики БУ техники (Фаза 10, роли ONLINE_PURCHASER / OFFLINE_PURCHASER
  // из docs/payroll/prd-payroll-calculation.md, раздел "Роли магазина") —
  // сознательно НЕ внешний ключ на MoySkladEmployee, в отличие от
  // MoySkladDemand.onlineManagerId/offlineManagerId. Открытый вопрос PRD "где
  // физически лежат закупщики и какой тип значения" решён здесь: закупщики
  // лежат на уровне позиции отгрузки (а не карточки товара — см.
  // MoySkladProduct), а тип значения кастомного атрибута МойСклад заранее не
  // известен (employee-ссылка или произвольная строка) — оба случая
  // приводятся синком к строковому идентификатору (см.
  // sync/moySklad/moysklad-sync.mappers.ts, extractPurchaserExternalId) и
  // сопоставляются с EmployeeIdentity тем же механизмом, что и строковое
  // поле "онлайн-менеджер" RemOnline (identifierType
  // MOY_SKLAD_ONLINE_PURCHASER_FIELD / MOY_SKLAD_OFFLINE_PURCHASER_FIELD в
  // employee-identity.prisma), а не прямым JOIN.
  onlinePurchaserId  String? @map("online_purchaser_id")
  offlinePurchaserId String? @map("offline_purchaser_id")

  demand  MoySkladDemand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  product MoySkladProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  service MoySkladService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([demandId])
  @@index([productId])
  @@index([serviceId])
  @@index([onlinePurchaserId])
  @@index([offlinePurchaserId])
  @@map("moy_sklad_demand_positions")
}
