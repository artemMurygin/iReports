model BitrixDeal {
  id               Int                   @id @unique
  title            String?
  opportunity      Int?
  categoryId       Int
  stageId          String?               @map("stage_id")
  stage            BitrixStage?          @relation(fields: [stageId], references: [id])
  assignedById     Int?                  @map("assigned_by_id")
  assignedBy       BitrixEmployee?       @relation(fields: [assignedById], references: [id])
  contactId        Int?                  @map("contact_id")
  pointOfContactId String?               @map("point_of_contact_id")
  pointOfContact   BitrixPointOfContact? @relation(fields: [pointOfContactId], references: [id])
  leadSourceId     Int?                  @map("lead_source_id")
  leadSource       BitrixLeadSources?    @relation(fields: [leadSourceId], references: [id])
  brandId          Int?                  @map("brand_id")
  brand            BitrixEnumValue?      @relation("DealBrand", fields: [brandId], references: [id])
  deviceTypeId     Int?                  @map("device_type_id")
  deviceType       BitrixDeviceTypes?    @relation(fields: [deviceTypeId], references: [id])
  deviceModel      String?               @map("device_model")

  deviceMalfunction String?   @map("device_malfunction")
  createdAt         DateTime  @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")

  @@map("bitrix_deals")
}

model BitrixDepartment {
  id   Int    @id
  name String

  employees BitrixEmployee[]
  // См. sales.prisma (Фаза 3, docs/payroll/plan-payroll-calculation.md) —
  // план продаж и его дефолтный шаблон всегда привязаны к отделу.
  salesPlanTemplates SalesPlanTemplate[]
  salesPlans         SalesPlan[]

  @@map("bitrix_departments")
}

model BitrixEmployee {
  id           Int    @id
  firstName    String
  lastName     String
  departmentId Int    @map("department")

  /// Активность пользователя в Bitrix24 (поле ACTIVE user.get) — false у уволенного
  /// сотрудника. Синхронизируется BitrixSyncService.uploadEmployees(); читается
  /// при закрытии расчётного периода для признака isDismissed документа
  /// начисления (PRD 1 docs/payroll-closing-and-accrual).
  isActive Boolean @default(true) @map("is_active")

  /// Должность сотрудника (Bitrix24 WORK_POSITION) — для карточки сотрудника
  /// в сквозном списке взаиморасчётов (docs/employee-settlements-page-redesign,
  /// Фаза 1). NULL — должность ещё не подтянута синхронизацией.
  /// TODO(employee-settlements-page-redesign): BitrixSyncService.uploadEmployees()
  /// пока не читает WORK_POSITION из user.get — поле лежит незаполненным,
  /// пока не появится отдельная задача на доработку синхронизации.
  position String? @map("position")

  /// Локальный, независимый от Bitrix24-синхронизации порядок отображения
  /// сотрудника (docs/employee-ordering-and-salary-filter, Фаза 1) — единый
  /// для всех списков/справочников сотрудников (справочник, отчёт по
  /// зарплате, взаиморасчёты/баланс, зарплатные схемы, график работы,
  /// связи сотрудников). Меняется только через reorder-эндпоинт
  /// (modules/directory), НЕ читается и НЕ пишется BitrixSyncService.
  /// uploadEmployees() — сознательно исключено из цикла синхронизации.
  /// Начальные значения (миграция) — по прежнему алфавитному порядку
  /// (lastName, firstName), которым раньше сортировался справочник по
  /// умолчанию; новые сотрудники, засинканные позже, получают DEFAULT 0
  /// (осмысленное упорядочивание для них — вручную через reorder).
  order Int @default(0) @map("order")

  /// Локальный, независимый от Bitrix24-синхронизации признак «служебный
  /// аккаунт» (docs/employee-ordering-and-salary-filter, Фаза 3) — заводится
  /// частью отделов для технических целей, не обозначает реального
  /// сотрудника. Независим от isActive (тот означает «уволен») — служебный
  /// аккаунт при этом обычно isActive: true. Сотрудник с isServiceAccount:
  /// true исключается из ВСЕХ зарплатных выборок (отчёт по зарплате,
  /// взаиморасчёты/баланс, зарплатные схемы, справочник выбора сотрудника
  /// при создании отчёта) — из списков, расчётов и итоговых сумм
  /// (DirectoryRepository.findEmployees default-фильтрует
  /// isServiceAccount: false; см. FindEmployeesOptions.includeServiceAccounts
  /// для явных исключений: график работы и связи сотрудников (EmployeeIdentity)
  /// продолжают видеть служебных сотрудников без изменений — PRD, "Не в
  /// скоупе": "Скрытие служебных сотрудников за пределами зарплатного
  /// раздела"). Меняется только через PATCH .../employees/:id/service-account
  /// (modules/directory), НЕ читается и НЕ пишется BitrixSyncService.
  /// uploadEmployees() — сознательно исключено из цикла синхронизации, тем
  /// же приёмом, что и order выше.
  isServiceAccount Boolean @default(false) @map("is_service_account")

  /// @deprecated Заменено на EmployeeIdentity(system: ROAPP, identifierType: EMPLOYEE_ID)
  /// — см. employee-identity.prisma и Фазу 2 docs/payroll/plan-payroll-calculation.md.
  /// Поле оставлено для истории/переходного периода, новые связи сюда не пишутся.
  roappId Int? @unique @map("roapp_id")
  /// @deprecated Заменено на EmployeeIdentity(system: MOY_SKLAD, identifierType: EMPLOYEE_ID).
  moySkladId String? @unique @map("moy_sklad_id")
  /// @deprecated Заменено на EmployeeIdentity(system: ROAPP, identifierType: ONLINE_MANAGER_FIELD).
  roappOnlineName String? @unique @map("roapp_online_name")

  department       BitrixDepartment   @relation(fields: [departmentId], references: [id])
  roappEmployee    RoappEmployee?     @relation(fields: [roappId], references: [id], onDelete: SetNull)
  moySkladEmployee MoySkladEmployee?  @relation(fields: [moySkladId], references: [id], onDelete: SetNull)
  identities       EmployeeIdentity[]

  bitrixDeal BitrixDeal[]

  @@map("bitrix_employees")
}

model BitrixEnumValue {
  id         Int          @id
  fieldName  String       @map("field_name")
  value      String
  sort       Int
  brandDeals BitrixDeal[] @relation("DealBrand")

  @@map("bitrix_enum_values")
}

model BitrixStage {
  id             String       @id
  name           String
  sort           Int
  color          String
  systemType     String       @map("system_type")
  entityId       String       @map("entity_id")
  stageGroupId   String?      @map("stage_group_id")
  stageGroupName String?      @map("stage_group_name")
  deals          BitrixDeal[]

  @@map("bitrix_stages")
}

model BitrixPointOfContact {
  id    String       @id
  name  String
  sort  Int
  deals BitrixDeal[]

  @@map("bitrix_point_of_contacts")
}

model BitrixDeviceTypes {
  id    Int          @id
  name  String
  deals BitrixDeal[]

  @@map("bitrix_device_types")
}

model BitrixLeadSources {
  id    Int          @id
  name  String
  deals BitrixDeal[]

  @@map("bitrix_lead_sources")
}

model BitrixInstallation {
  id              Int      @id @default(autoincrement())
  memberId        String   @unique @map("member_id")
  domain          String
  accessToken     String   @map("access_token")
  refreshToken    String   @map("refresh_token")
  clientEndpoint  String   @map("client_endpoint")
  serverEndpoint  String   @map("server_endpoint")
  accessExpiresAt DateTime @map("access_expires_at")
  installedAt     DateTime @default(now()) @map("installed_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("bitrix_installations")
}
