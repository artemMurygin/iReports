model BitrixDeal {
  id                Int              @id @unique
  title             String
  opportunity       Int?
  stageId           Int              @map("stage_id")
  stage             BitrixStage      @relation(fields: [stageId], references: [id])
  assignedById      Int              @map("assigned_by_id")
  assignedBy        BitrixEmployee   @relation(fields: [assignedById], references: [id])
  contactId         Int              @map("contact_id")
  sourceId          Int?             @map("source_id")
  source            BitrixSource?    @relation(fields: [sourceId], references: [id])
  leadSourceId      Int?             @map("lead_source_id")
  leadSource        BitrixEnumValue? @relation("DealLeadSource", fields: [leadSourceId], references: [id])
  brandId           Int?             @map("brand_id")
  brand             BitrixEnumValue? @relation("DealBrand", fields: [brandId], references: [id])
  deviceTypeId      Int?             @map("device_type_id")
  deviceType        BitrixEnumValue? @relation("DealDeviceType", fields: [deviceTypeId], references: [id])
  deviceModelId     Int?             @map("device_model_id")
  deviceModel       BitrixEnumValue? @relation("DealDeviceModel", fields: [deviceModelId], references: [id])
  deviceMalfunction String?          @map("device_malfunction")
  createdAt         DateTime         @map("created_at")
  updatedAt         DateTime?        @updatedAt @map("updated_at")

  @@map("bitrix_deals")
}

model BitrixEmployee {
  id         Int          @id
  firstName  String
  lastName   String
  BitrixDeal BitrixDeal[]

  @@map("bitrix_employees")
}

model BitrixEnumValue {
  id               Int          @id
  fieldName        String       @map("field_name")
  value            String
  sort             Int
  leadSourceDeals  BitrixDeal[] @relation("DealLeadSource")
  brandDeals       BitrixDeal[] @relation("DealBrand")
  deviceTypeDeals  BitrixDeal[] @relation("DealDeviceType")
  deviceModelDeals BitrixDeal[] @relation("DealDeviceModel")

  @@map("bitrix_enum_values")
}

model BitrixStage {
  id         Int          @id
  name       String
  sort       Int
  color      String
  systemType String       @map("system_type")
  entityId   String       @map("entity_id")
  deals      BitrixDeal[]

  @@map("bitrix_stages")
}

model BitrixSource {
  id    Int          @id
  name  String
  sort  Int
  deals BitrixDeal[]

  @@map("bitrix_sources")
}

