enum SalaryReportMetricType {
  revenue
  margin

  @@map("salary_report_metric_type")
}

enum SalaryReportPayoutBase {
  revenue
  margin

  @@map("salary_report_payout_base")
}

enum SalaryReportFactSource {
  moy_sklad
  roapp
  manual

  @@map("salary_report_fact_source")
}

// ─────────────────────────────────────────────────────────────────────────
// Направления: Магазин, Сервис
// ─────────────────────────────────────────────────────────────────────────
model SalaryReportDirection {
  id   Int    @id @default(autoincrement())
  name String @unique

  targets SalaryReportTarget[]
  rules   SalaryReportMotivationRule[]

  @@map("salary_report_directions")
}

// ─────────────────────────────────────────────────────────────────────────
// Цель расчёта: что измеряем (категория магазина / категория сервиса / всё направление)
// Ссылается напрямую на существующие таблицы категорий.
// Если все FK = null → цель = всё направление целиком.
// ─────────────────────────────────────────────────────────────────────────
model SalaryReportTarget {
  id                     Int                    @id @default(autoincrement())
  directionId            Int                    @map("direction_id")
  metric                 SalaryReportMetricType @default(revenue)
  moySkladFolderId       String?                @map("moy_sklad_folder_id")
  roappServiceCategoryId Int?                   @map("roapp_service_category_id")
  roappProductCategoryId Int?                   @map("roapp_product_category_id")

  direction            SalaryReportDirection  @relation(fields: [directionId], references: [id])
  moySkladFolder       MoySkladProductFolder? @relation(fields: [moySkladFolderId], references: [id], onDelete: SetNull)
  roappServiceCategory RoappServiceCategory?  @relation(fields: [roappServiceCategoryId], references: [id], onDelete: SetNull)
  roappProductCategory RoappProductCategory?  @relation(fields: [roappProductCategoryId], references: [id], onDelete: SetNull)

  ruleItems SalaryReportRuleItem[]
  plans     SalaryReportPlan[]
  facts     SalaryReportFact[]

  // Уникальность по полному набору FK + metric.
  // Для "всё направление" (все FK = null) дополнительный partial index создаётся в миграции.
  @@unique([directionId, moySkladFolderId, roappServiceCategoryId, roappProductCategoryId, metric])
  @@map("salary_report_targets")
}

// ─────────────────────────────────────────────────────────────────────────
// Шкала коэффициента
// ─────────────────────────────────────────────────────────────────────────
model SalaryReportCoefficientScale {
  id   Int    @id @default(autoincrement())
  name String

  points SalaryReportCoefficientPoint[]
  rules  SalaryReportMotivationRule[]

  @@map("salary_report_coefficient_scales")
}

// ─────────────────────────────────────────────────────────────────────────
// Опорные точки шкалы (пошаговая кривая: выполнение % → коэффициент)
// ─────────────────────────────────────────────────────────────────────────
model SalaryReportCoefficientPoint {
  id             Int     @id @default(autoincrement())
  scaleId        Int     @map("scale_id")
  fulfillmentPct Decimal @map("fulfillment_pct") @db.Decimal(6, 4)
  coefficient    Decimal @db.Decimal(6, 4)

  scale SalaryReportCoefficientScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, fulfillmentPct])
  @@map("salary_report_coefficient_points")
}

// ─────────────────────────────────────────────────────────────────────────
// Правило расчёта зарплаты (например «Магазин 2026», «Сервис 2026»)
// ─────────────────────────────────────────────────────────────────────────
model SalaryReportMotivationRule {
  id            Int                    @id @default(autoincrement())
  name          String
  directionId   Int                    @map("direction_id")
  scaleId       Int                    @map("scale_id")
  payoutBase    SalaryReportPayoutBase @default(margin) @map("payout_base")
  effectiveFrom DateTime?              @map("effective_from") @db.Date

  direction     SalaryReportDirection        @relation(fields: [directionId], references: [id])
  scale         SalaryReportCoefficientScale @relation(fields: [scaleId], references: [id])
  items         SalaryReportRuleItem[]
  employeeRules SalaryReportEmployeeRule[]
  results       SalaryReportResult[]

  @@map("salary_report_motivation_rules")
}

// ─────────────────────────────────────────────────────────────────────────
// Цели внутри правила: базовый % по каждой цели
// ─────────────────────────────────────────────────────────────────────────
model SalaryReportRuleItem {
  id          Int     @id @default(autoincrement())
  ruleId      Int     @map("rule_id")
  targetId    Int     @map("target_id")
  basePercent Decimal @map("base_percent") @db.Decimal(6, 4)

  rule   SalaryReportMotivationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  target SalaryReportTarget         @relation(fields: [targetId], references: [id])

  @@unique([ruleId, targetId])
  @@map("salary_report_rule_items")
}

// ─────────────────────────────────────────────────────────────────────────
// План по периодам (первое число месяца)
// ─────────────────────────────────────────────────────────────────────────
model SalaryReportPlan {
  id       Int      @id @default(autoincrement())
  targetId Int      @map("target_id")
  period   DateTime @db.Date
  value    Decimal  @db.Decimal(14, 2)

  target SalaryReportTarget @relation(fields: [targetId], references: [id])

  @@unique([targetId, period])
  @@map("salary_report_plans")
}

// ─────────────────────────────────────────────────────────────────────────
// Факт по периодам (агрегат из MoySklad / Roapp / ручной ввод)
// ─────────────────────────────────────────────────────────────────────────
model SalaryReportFact {
  id       Int                    @id @default(autoincrement())
  targetId Int                    @map("target_id")
  period   DateTime               @db.Date
  value    Decimal                @db.Decimal(14, 2)
  source   SalaryReportFactSource @default(manual)
  syncedAt DateTime?              @map("synced_at")

  target SalaryReportTarget @relation(fields: [targetId], references: [id])

  @@unique([targetId, period])
  @@map("salary_report_facts")
}

// ─────────────────────────────────────────────────────────────────────────
// Привязка сотрудника или отдела к правилу расчёта.
// Ровно одно из полей bitrixEmployeeId / bitrixDepartmentId должно быть заполнено
// (CHECK-ограничение добавляется в SQL-миграции).
// ─────────────────────────────────────────────────────────────────────────
model SalaryReportEmployeeRule {
  id                 Int       @id @default(autoincrement())
  ruleId             Int       @map("rule_id")
  bitrixEmployeeId   Int?      @map("bitrix_employee_id")
  bitrixDepartmentId Int?      @map("bitrix_department_id")
  effectiveFrom      DateTime  @map("effective_from") @db.Date
  effectiveTo        DateTime? @map("effective_to") @db.Date

  rule             SalaryReportMotivationRule @relation(fields: [ruleId], references: [id])
  bitrixEmployee   BitrixEmployee?            @relation(fields: [bitrixEmployeeId], references: [id], onDelete: SetNull)
  bitrixDepartment BitrixDepartment?          @relation(fields: [bitrixDepartmentId], references: [id], onDelete: SetNull)

  @@map("salary_report_employee_rules")
}

// ─────────────────────────────────────────────────────────────────────────
// Итоговый расчёт зарплаты сотрудника за период (для истории и аудита)
// ─────────────────────────────────────────────────────────────────────────
model SalaryReportResult {
  id               Int      @id @default(autoincrement())
  ruleId           Int      @map("rule_id")
  bitrixEmployeeId Int      @map("bitrix_employee_id")
  period           DateTime @db.Date
  computedSalary   Decimal  @map("computed_salary") @db.Decimal(14, 2)
  computedAt       DateTime @default(now()) @map("computed_at")

  rule           SalaryReportMotivationRule @relation(fields: [ruleId], references: [id])
  bitrixEmployee BitrixEmployee             @relation(fields: [bitrixEmployeeId], references: [id])

  @@unique([bitrixEmployeeId, period])
  @@map("salary_report_results")
}
